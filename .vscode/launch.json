{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    },
    {
      "name": "Backend: unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", ".", "-v"],
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Train models (NumPy)",
      "type": "debugpy",
      "request": "launch",
      "module": "neurocompress.train",
      "args": ["--models", "tiny", "small", "base", "large"],
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend: open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ]
}
