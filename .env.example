# Copy to ".env" (the start scripts do this automatically on first run).
# Ports (the start scripts pick the next free port automatically if these are busy)
BACKEND_PORT=8000
VITE_PORT=5173

# Frontend -> backend connection. Leave empty to use the Vite proxy (recommended).
# VITE_API_PROXY_TARGET is set automatically by the start scripts; set it by hand only if you run the
# backend yourself on another port/host.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Backend
NC_MAX_UPLOAD_MB=20
NC_MAX_PIXELS=1048576
NC_RETENTION_HOURS=72
# NC_DATA_DIR=./backend/data
# Extra CORS origins (any http://localhost:<port> / 127.0.0.1:<port> is always allowed)
# NC_CORS_ORIGINS=http://localhost:5173
